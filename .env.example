# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Identifiants Mailjet (compte existant)
MAILJET_API_KEY=xxxxx
MAILJET_SECRET_KEY=xxxxx

# Google Indexing API (indexation auto des articles de blog)
# Fournir la cle du compte de service par UNE de ces voies :
#   - GCP_INDEXING_SA_KEY_B64 : le fichier JSON de la cle encode en base64 (recommande)
#   - GCP_INDEXING_SA_KEY_JSON : le JSON brut sur une seule ligne
#   - ou placer le fichier gcp-indexing-sa.json a la racine (gitignore)
# Le compte de service doit etre PROPRIETAIRE de la propriete Search Console.
GCP_INDEXING_SA_KEY_B64=xxxxx
